
flowchart TD
    A["User enters URL in Browser"] --> B["Browser parses URL"]
    B --> C["Check Browser DNS Cache"]
    C -->|Cache Hit| G["IP Address Available"]
    C -->|Cache Miss| D["Check OS DNS Cache"]
    D -->|Cache Hit| G
    D -->|Cache Miss| E["Contact Recursive DNS Resolver"]
    E --> F["Root DNS → TLD DNS → Authoritative DNS"]
    F --> G

    G --> H["Establish Connection"]
    H --> I["TCP Three-Way Handshake: SYN → SYN-ACK → ACK"]
    I --> J["TLS Handshake for HTTPS"]
    J --> K["Secure Connection Established"]
    K --> L["Browser Sends HTTP Request"]

    L --> M["Request Reaches Server / Load Balancer"]
    M --> N["Request Routing to Backend Application"]
    N --> O["Spring Boot / REST Controller"]
    O --> P["Authentication and Authorization"]
    P --> Q["Input Validation"]
    Q --> R["Service Layer: Business Logic"]
    R --> S["Repository / DAO Layer"]
    S --> T["Database Query"]
    T --> U["Database Returns Result"]
    U --> V["Service Processes Result"]
    V --> W["Controller Creates HTTP Response"]
    W --> X["Response Sent to Client"]
    X --> Y["Browser Processes Response"]
    Y --> Z["Page / Data Displayed"]
